# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=videoeditor-2508b
GCS_BUCKET_NAME=your-bucket-name-here

# Service Account Key (choose one method)
# Method 1: Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account-key.json
FIREBASE_SERVICE_ACCOUNT_KEY=./path/to/service-account-key.json

# Method 2: Use default credentials (gcloud auth application-default login)
# Leave the above blank and use default credentials

# Firebase Configuration
FIREBASE_PROJECT_ID=videoeditor-2508b

# OBS Configuration
# Windows example:
# OBS_RECORDING_FOLDER=C:/Users/YourName/Videos/OBS Recordings
# Mac example:
# OBS_RECORDING_FOLDER=/Users/YourName/Movies/OBS Recordings
# Linux example:
# OBS_RECORDING_FOLDER=/home/username/Videos/OBS Recordings
OBS_RECORDING_FOLDER=

# File Watching Configuration
WATCH_EXTENSIONS=.mp4,.mkv
MIN_FILE_SIZE_MB=10
STABILITY_WAIT_MS=5000

# Optional: Archive folder (moves files after upload)
# ARCHIVE_FOLDER=./archive

# Optional: Logging
# LOG_FILE=./logs/watcher.log

# Environment
NODE_ENV=development
